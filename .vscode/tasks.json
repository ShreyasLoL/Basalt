{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BASALT: Configure",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build", "-DCMAKE_BUILD_TYPE=Release"],
      "problemMatcher": []
    },
    {
      "label": "BASALT: Build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--config", "Release"],
      "dependsOn": "BASALT: Configure",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "BASALT: Test",
      "type": "shell",
      "command": "ctest",
      "args": ["--test-dir", "${workspaceFolder}/build", "-C", "Release", "--output-on-failure"],
      "dependsOn": "BASALT: Build",
      "problemMatcher": []
    },
    {
      "label": "BASALT: Benchmark",
      "type": "shell",
      "command": "${workspaceFolder}/build/basalt_bench.exe",
      "args": ["--orders", "50000"],
      "dependsOn": "BASALT: Build",
      "problemMatcher": []
    },
    {
      "label": "BASALT: Run Server",
      "type": "shell",
      "command": "${workspaceFolder}/build/basalt_server.exe",
      "dependsOn": "BASALT: Build",
      "problemMatcher": []
    }
  ]
}
