{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Atlas Server",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/atlas_server.exe",
      "args": ["--port", "8080"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "environment": [],
      "console": "integratedTerminal"
    },
    {
      "name": "Atlas Tests",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/atlas_tests.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "environment": [],
      "console": "integratedTerminal"
    },
    {
      "name": "Atlas Benchmark",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/atlas_bench.exe",
      "args": ["--orders", "50000"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "environment": [],
      "console": "integratedTerminal"
    }
  ]
}
