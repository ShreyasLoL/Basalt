{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BASALT Server",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/basalt_server.exe",
      "args": ["--port", "8080"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "environment": [],
      "console": "integratedTerminal"
    },
    {
      "name": "BASALT Tests",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/basalt_tests.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "environment": [],
      "console": "integratedTerminal"
    },
    {
      "name": "BASALT Benchmark",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/basalt_bench.exe",
      "args": ["--orders", "50000"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "environment": [],
      "console": "integratedTerminal"
    }
  ]
}
